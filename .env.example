# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration
# Set to 'true' to use the zero-latency deterministic mock banking engine (works 100% offline)
MOCK_AI=true

# Optional: Provide OpenAI API Key if MOCK_AI=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
